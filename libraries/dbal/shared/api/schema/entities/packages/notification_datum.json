{
  "entity": "NotificationDatum",
  "version": "1.0",
  "description": "One field of a notification's payload. Payload shape varies by notification type, which is why it was a document; a row per field keeps it open-ended and still queryable.",
  "fields": {
    "id": {
      "type": "string",
      "primary": true,
      "generated": true
    },
    "tenantId": {
      "type": "string",
      "optional": true,
      "nullable": true
    },
    "notificationId": {
      "type": "string",
      "required": true,
      "foreign_key": {
        "entity": "Notification",
        "field": "id",
        "on_delete": "cascade"
      }
    },
    "name": {
      "type": "string",
      "required": true,
      "max_length": 100
    },
    "value": {
      "type": "text",
      "optional": true,
      "nullable": true
    },
    "valueType": {
      "type": "enum",
      "values": [
        "string",
        "number",
        "boolean"
      ],
      "required": true,
      "default": "string"
    }
  },
  "indexes": [
    {
      "fields": [
        "notificationId"
      ]
    },
    {
      "fields": [
        "notificationId",
        "name"
      ],
      "unique": true
    },
    {
      "fields": [
        "name"
      ]
    }
  ],
  "relations": {
    "notification": {
      "type": "belongs-to",
      "entity": "Notification",
      "foreign_key": "notificationId",
      "on_delete": "cascade"
    }
  },
  "acl": {
    "create": {
      "role": [
        "god",
        "supergod"
      ]
    },
    "read": {
      "public": true
    },
    "update": {
      "role": [
        "god",
        "supergod"
      ]
    },
    "delete": {
      "role": [
        "god",
        "supergod"
      ]
    }
  }
}
