{
  "entity": "AuditLogField",
  "version": "1.0",
  "description": "One field of an audit entry: a detail, or one side of a before/after pair. `kind` says which, so details, oldValue and newValue share one table instead of three documents.",
  "fields": {
    "id": {
      "type": "string",
      "primary": true,
      "generated": true
    },
    "tenantId": {
      "type": "string",
      "optional": true,
      "nullable": true
    },
    "auditLogId": {
      "type": "string",
      "required": true,
      "foreign_key": {
        "entity": "AuditLog",
        "field": "id",
        "on_delete": "cascade"
      }
    },
    "kind": {
      "type": "enum",
      "values": [
        "detail",
        "old",
        "new"
      ],
      "required": true,
      "default": "detail"
    },
    "name": {
      "type": "string",
      "required": true,
      "max_length": 100
    },
    "value": {
      "type": "text",
      "optional": true,
      "nullable": true
    },
    "valueType": {
      "type": "enum",
      "values": [
        "string",
        "number",
        "boolean"
      ],
      "required": true,
      "default": "string"
    },
    "sortOrder": {
      "type": "integer",
      "required": true,
      "default": 0,
      "description": "Position within a repeated value. A list-valued field is several rows sharing a name, rather than name.0, name.1 encoded as paths."
    }
  },
  "indexes": [
    {
      "fields": [
        "auditLogId"
      ]
    },
    {
      "fields": [
        "auditLogId",
        "kind"
      ]
    },
    {
      "fields": [
        "auditLogId",
        "kind",
        "name",
        "sortOrder"
      ],
      "unique": true
    }
  ],
  "relations": {
    "entry": {
      "type": "belongs-to",
      "entity": "AuditLog",
      "foreign_key": "auditLogId",
      "on_delete": "cascade"
    }
  },
  "acl": {
    "create": {
      "role": [
        "god",
        "supergod"
      ]
    },
    "read": {
      "public": true
    },
    "update": {
      "role": [
        "god",
        "supergod"
      ]
    },
    "delete": {
      "role": [
        "god",
        "supergod"
      ]
    }
  }
}
