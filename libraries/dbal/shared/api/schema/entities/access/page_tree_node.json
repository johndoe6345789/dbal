{
  "entity": "PageTreeNode",
  "version": "2.0",
  "description": "One node of a page tree. Shape comes from the rows: parentId gives the nesting and sortOrder the order among siblings, so a tree is a query rather than a document. Properties live in ComponentProp, one row per property.",
  "fields": {
    "id": {
      "type": "string",
      "primary": true,
      "generated": true
    },
    "tenantId": {
      "type": "string",
      "optional": true,
      "nullable": true
    },
    "treeId": {
      "type": "string",
      "required": true,
      "foreign_key": {
        "entity": "PageTree",
        "field": "id",
        "on_delete": "cascade"
      },
      "description": "The tree this node belongs to"
    },
    "parentId": {
      "type": "string",
      "optional": true,
      "nullable": true,
      "foreign_key": {
        "entity": "PageTreeNode",
        "field": "id",
        "on_delete": "cascade"
      },
      "description": "Parent node; null for the root of the tree"
    },
    "type": {
      "type": "string",
      "required": true,
      "max_length": 100,
      "description": "Block type from the registry, e.g. html.h1 or m3.paper"
    },
    "sortOrder": {
      "type": "integer",
      "required": true,
      "default": 0,
      "description": "Order among siblings"
    }
  },
  "indexes": [
    {
      "fields": [
        "treeId"
      ]
    },
    {
      "fields": [
        "parentId"
      ]
    },
    {
      "fields": [
        "treeId",
        "parentId",
        "sortOrder"
      ]
    }
  ],
  "relations": {
    "tree": {
      "type": "belongs-to",
      "entity": "PageTree",
      "foreign_key": "treeId",
      "on_delete": "cascade"
    },
    "parent": {
      "type": "belongs-to",
      "entity": "PageTreeNode",
      "foreign_key": "parentId",
      "nullable": true,
      "on_delete": "cascade"
    },
    "children": {
      "type": "has-many",
      "entity": "PageTreeNode",
      "foreign_key": "parentId",
      "cascade_delete": true
    },
    "props": {
      "type": "has-many",
      "entity": "PageTreeProp",
      "foreign_key": "nodeId",
      "cascade_delete": true
    }
  },
  "acl": {
    "create": {
      "role": [
        "god",
        "supergod"
      ]
    },
    "read": {
      "public": true
    },
    "update": {
      "role": [
        "god",
        "supergod"
      ]
    },
    "delete": {
      "role": [
        "god",
        "supergod"
      ]
    }
  }
}
