{
  "entity": "PageConfig",
  "version": "1.0",
  "description": "Page configuration and layout definition",
  "fields": {
    "id": {
      "type": "string",
      "primary": true,
      "generated": true
    },
    "tenantId": {
      "type": "string",
      "optional": true,
      "nullable": true
    },
    "packageId": {
      "type": "string",
      "optional": true,
      "nullable": true,
      "description": "Package that defined this route"
    },
    "path": {
      "type": "string",
      "required": true,
      "max_length": 255,
      "description": "URL path for this page"
    },
    "title": {
      "type": "string",
      "required": true,
      "max_length": 255,
      "description": "Page title"
    },
    "description": {
      "type": "text",
      "optional": true,
      "nullable": true,
      "description": "Page description"
    },
    "icon": {
      "type": "string",
      "optional": true,
      "nullable": true
    },
    "component": {
      "type": "string",
      "optional": true,
      "nullable": true
    },
    "pageTreeId": {
      "type": "string",
      "optional": true,
      "nullable": true,
      "foreign_key": {
        "entity": "PageTree",
        "field": "id",
        "on_delete": "set_null"
      },
      "description": "The PageTree this route renders. The tree itself is rows in PageTreeNode and PageTreeProp."
    },
    "level": {
      "type": "integer",
      "required": true,
      "min": 0,
      "max": 5,
      "description": "Access level required, matching ROLE_LEVELS: 0=public, 1=user, 2=moderator, 3=admin, 4=god, 5=supergod"
    },
    "requiresAuth": {
      "type": "boolean",
      "required": true
    },
    "requiredRole": {
      "type": "string",
      "optional": true,
      "nullable": true
    },
    "parentPath": {
      "type": "string",
      "optional": true,
      "nullable": true
    },
    "sortOrder": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "isPublished": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "params": {
      "type": "string",
      "optional": true,
      "nullable": true
    },
    "meta": {
      "type": "string",
      "optional": true,
      "nullable": true
    },
    "createdAt": {
      "type": "bigint",
      "optional": true,
      "nullable": true
    },
    "updatedAt": {
      "type": "bigint",
      "optional": true,
      "nullable": true
    }
  },
  "indexes": [
    {
      "fields": [
        "tenantId",
        "path"
      ],
      "unique": true
    },
    {
      "fields": [
        "level"
      ]
    },
    {
      "fields": [
        "isPublished"
      ]
    },
    {
      "fields": [
        "pageTreeId"
      ]
    }
  ],
  "relations": {
    "components": {
      "type": "has-many",
      "entity": "ComponentNode",
      "foreign_key": "pageId",
      "cascade_delete": true,
      "description": "Component tree nodes belonging to this page"
    },
    "tree": {
      "type": "belongs-to",
      "entity": "PageTree",
      "foreign_key": "pageTreeId",
      "nullable": true,
      "on_delete": "set_null",
      "description": "Component tree rendered for this route"
    }
  },
  "acl": {
    "create": {
      "role": [
        "god",
        "supergod"
      ]
    },
    "read": {
      "public": true
    },
    "update": {
      "role": [
        "god",
        "supergod"
      ]
    },
    "delete": {
      "role": [
        "god",
        "supergod"
      ]
    }
  }
}
