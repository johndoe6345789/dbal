{
  "entity": "InstalledPackageSetting",
  "version": "1.0",
  "description": "One setting of an installed package. A row per setting, so a flag can be read or flipped without rewriting the package's whole configuration.",
  "fields": {
    "id": {
      "type": "string",
      "primary": true,
      "generated": true
    },
    "tenantId": {
      "type": "string",
      "optional": true,
      "nullable": true
    },
    "installedPackageId": {
      "type": "string",
      "required": true,
      "foreign_key": {
        "entity": "InstalledPackage",
        "field": "id",
        "on_delete": "cascade"
      }
    },
    "name": {
      "type": "string",
      "required": true,
      "max_length": 100
    },
    "value": {
      "type": "text",
      "optional": true,
      "nullable": true
    },
    "valueType": {
      "type": "enum",
      "values": [
        "string",
        "number",
        "boolean"
      ],
      "required": true,
      "default": "string"
    }
  },
  "indexes": [
    {
      "fields": [
        "installedPackageId"
      ]
    },
    {
      "fields": [
        "installedPackageId",
        "name"
      ],
      "unique": true
    }
  ],
  "relations": {
    "package": {
      "type": "belongs-to",
      "entity": "InstalledPackage",
      "foreign_key": "installedPackageId",
      "on_delete": "cascade"
    }
  },
  "acl": {
    "create": {
      "role": [
        "god",
        "supergod"
      ]
    },
    "read": {
      "public": true
    },
    "update": {
      "role": [
        "god",
        "supergod"
      ]
    },
    "delete": {
      "role": [
        "god",
        "supergod"
      ]
    }
  }
}
