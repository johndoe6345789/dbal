{
  "entity": "InstalledPackage",
  "version": "1.0",
  "description": "Installed package metadata",
  "fields": {
    "id": {
      "type": "string",
      "primary": true,
      "generated": true
    },
    "packageId": {
      "type": "string",
      "required": true,
      "description": "Package identifier"
    },
    "tenantId": {
      "type": "string",
      "optional": true,
      "nullable": true
    },
    "installedAt": {
      "type": "bigint",
      "optional": true,
      "nullable": true
    },
    "version": {
      "type": "string",
      "required": true,
      "description": "Semantic version"
    },
    "enabled": {
      "type": "boolean",
      "required": true
    }
  },
  "indexes": [
    {
      "fields": [
        "tenantId"
      ]
    },
    {
      "fields": [
        "packageId"
      ]
    }
  ],
  "relations": {
    "pages": {
      "type": "has-many",
      "entity": "UIPage",
      "foreign_key": "packageId",
      "cascade_delete": true,
      "description": "UI pages belonging to this package"
    }
  },
  "acl": {
    "create": {
      "role": [
        "god",
        "supergod"
      ]
    },
    "read": {
      "role": [
        "god",
        "supergod"
      ]
    },
    "update": {
      "role": [
        "god",
        "supergod"
      ]
    },
    "delete": {
      "role": [
        "god",
        "supergod"
      ]
    }
  }
}
