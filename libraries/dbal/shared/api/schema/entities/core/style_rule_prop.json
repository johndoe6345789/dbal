{
  "entity": "StyleRuleProp",
  "version": "1.0",
  "description": "One CSS declaration on one rule -- property and value. Queryable, so 'everything using this colour' is answerable.",
  "fields": {
    "id": {
      "type": "string",
      "primary": true,
      "generated": true
    },
    "tenantId": {
      "type": "string",
      "optional": true,
      "nullable": true
    },
    "ruleId": {
      "type": "string",
      "required": true,
      "foreign_key": {
        "entity": "StyleRule",
        "field": "id",
        "on_delete": "cascade"
      }
    },
    "styleClassId": {
      "type": "string",
      "required": true,
      "foreign_key": {
        "entity": "StyleClass",
        "field": "id",
        "on_delete": "cascade"
      },
      "description": "Denormalised from ruleId so a sheet reads in one request."
    },
    "name": {
      "type": "string",
      "required": true,
      "max_length": 100
    },
    "value": {
      "type": "text",
      "required": true
    }
  },
  "indexes": [
    {
      "fields": [
        "styleClassId"
      ]
    },
    {
      "fields": [
        "ruleId"
      ]
    },
    {
      "fields": [
        "ruleId",
        "name"
      ],
      "unique": true
    }
  ],
  "relations": {
    "rule": {
      "type": "belongs-to",
      "entity": "StyleRule",
      "foreign_key": "ruleId",
      "on_delete": "cascade"
    }
  },
  "acl": {
    "create": {
      "role": [
        "god",
        "supergod"
      ]
    },
    "read": {
      "public": true
    },
    "update": {
      "role": [
        "god",
        "supergod"
      ]
    },
    "delete": {
      "role": [
        "god",
        "supergod"
      ]
    }
  }
}
