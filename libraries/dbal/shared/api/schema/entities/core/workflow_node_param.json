{
  "entity": "WorkflowNodeParam",
  "version": "1.0",
  "description": "One parameter of one workflow step. A row per parameter, so a value can be read or changed without rewriting the workflow, and every step using a given setting is a query.",
  "fields": {
    "id": { "type": "string", "primary": true, "generated": true },
    "tenantId": { "type": "string", "optional": true, "nullable": true },
    "nodeId": {
      "type": "string",
      "required": true,
      "foreign_key": { "entity": "WorkflowNode", "field": "id", "on_delete": "cascade" }
    },
    "workflowId": {
      "type": "string",
      "required": true,
      "foreign_key": { "entity": "Workflow", "field": "id", "on_delete": "cascade" },
      "description": "Denormalised from nodeId. The data layer filters one column at a time and cannot join, so without it reading a workflow costs a request per step."
    },
    "name": { "type": "string", "required": true, "max_length": 100 },
    "value": { "type": "text", "optional": true, "nullable": true },
    "valueType": {
      "type": "enum",
      "values": ["string", "number", "boolean"],
      "required": true,
      "default": "string"
    }
  },
  "indexes": [
    { "fields": ["workflowId"] },
    { "fields": ["nodeId"] },
    { "fields": ["nodeId", "name"], "unique": true }
  ],
  "relations": {
    "node": { "type": "belongs-to", "entity": "WorkflowNode", "foreign_key": "nodeId", "on_delete": "cascade" }
  },
  "acl": {
    "create": { "role": ["god", "supergod"] },
    "read": { "public": true },
    "update": { "role": ["god", "supergod"] },
    "delete": { "role": ["god", "supergod"] }
  }
}
