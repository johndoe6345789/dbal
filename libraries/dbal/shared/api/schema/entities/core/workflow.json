{
  "entity": "Workflow",
  "name": "workflow",
  "displayName": "Workflow",
  "description": "Directed Acyclic Graph (DAG) workflow definitions with n8n schema support.\nSupports multi-tenant isolation, versioning, and execution tracking.\n",
  "tenantId": true,
  "fields": {
    "id": {
      "type": "string",
      "primary": true,
      "description": "Unique workflow identifier",
      "required": true,
      "unique": true
    },
    "tenantId": {
      "type": "string",
      "description": "Tenant isolation ID",
      "optional": true,
      "nullable": true
    },
    "name": {
      "type": "string",
      "description": "Human-readable workflow name",
      "required": true
    },
    "description": {
      "type": "string",
      "description": "Detailed workflow description",
      "optional": true,
      "nullable": true
    },
    "enabled": {
      "type": "boolean",
      "description": "DEPRECATED \u2014 superseded by 'status'. Nothing reads it: no seed record sets it, no UI renders it, and the workflow engine's 'enabled' flags belong to triggers/retry/rate-limit policies, not to the workflow itself. Kept as a nullable column so existing rows and any caller still sending it keep working; drop it once workflow.ops.json no longer lists it. Was required:true while every seed omitted it, which made the declaration unsatisfiable.",
      "optional": true,
      "nullable": true,
      "default": false
    },
    "status": {
      "type": "string",
      "description": "Lifecycle state \u2014 the authoritative one. Canonical values are 'draft' | 'active' | 'paused' | 'archived' (the WorkflowStatus union the UI renders and filters on); left as a plain string rather than an enum because rows predating the field are absent and read as 'draft'. Indexed on (tenantId, status) and used by the workflows:{tenantId}:{status} cache key.",
      "optional": true,
      "nullable": true
    },
    "category": {
      "type": "string",
      "description": "Grouping label, e.g. 'automation' or 'utilities'. Indexed on (tenantId, category).",
      "optional": true,
      "nullable": true
    },
    "triggerEvent": {
      "type": "string",
      "description": "The entity event that runs this workflow, as '<Entity>.created' -- the tenant is implied by the row. Empty means the workflow only runs when something asks for it by name.",
      "optional": true,
      "nullable": true
    },
    "isPublished": {
      "type": "boolean",
      "description": "Whether this workflow is published. Indexed on (tenantId, isPublished); raised by the workflow.published event.",
      "optional": true,
      "nullable": true,
      "default": false
    },
    "isArchived": {
      "type": "boolean",
      "description": "Soft-delete marker named by softDeleteField below. NOTE: softDelete/softDeleteField are declarative only \u2014 nothing in libraries/dbal/production/src reads either, so this column is never written today and DELETE is still a hard delete. It therefore does not currently conflict with status: 'archived', which is what the UI reads. Whoever implements soft delete must pick which of the two is authoritative and keep them in sync, rather than letting a row be isArchived=true while status says 'active'.",
      "optional": true,
      "nullable": true,
      "default": false
    },
    "version": {
      "type": "integer",
      "description": "Workflow version number",
      "required": true,
      "default": 1
    },
    "createdAt": {
      "type": "bigint",
      "description": "Workflow creation timestamp",
      "optional": true,
      "nullable": true
    },
    "updatedAt": {
      "type": "bigint",
      "description": "Last modification timestamp",
      "optional": true,
      "nullable": true
    },
    "createdBy": {
      "type": "string",
      "description": "User ID of creator",
      "optional": true,
      "nullable": true
    },
    "updatedBy": {
      "type": "string",
      "description": "User ID of last editor. Target of the 'updater' relation's foreign_key and of the workflow.updated event payload.",
      "optional": true,
      "nullable": true
    }
  },
  "indexes": [
    {
      "fields": [
        "tenantId",
        "name"
      ],
      "unique": true
    },
    {
      "fields": [
        "tenantId",
        "status"
      ]
    },
    {
      "fields": [
        "tenantId",
        "category"
      ]
    },
    {
      "fields": [
        "tenantId",
        "isPublished"
      ]
    },
    {
      "fields": [
        "tenantId",
        "createdAt"
      ]
    },
    {
      "fields": [
        "tenantId",
        "updatedAt"
      ]
    },
    {
      "fields": [
        "tenantId",
        "triggerEvent"
      ]
    }
  ],
  "relations": {
    "creator": {
      "type": "belongs-to",
      "entity": "User",
      "foreign_key": "createdBy",
      "on_delete": "restrict",
      "description": "User who created this workflow"
    },
    "updater": {
      "type": "belongs-to",
      "entity": "User",
      "foreign_key": "updatedBy",
      "nullable": true,
      "on_delete": "set_null",
      "description": "User who last updated this workflow"
    },
    "nodes": {
      "type": "has-many",
      "entity": "WorkflowNode",
      "foreign_key": "workflowId",
      "cascade_delete": true,
      "description": "Steps in this workflow"
    },
    "edges": {
      "type": "has-many",
      "entity": "WorkflowEdge",
      "foreign_key": "workflowId",
      "cascade_delete": true,
      "description": "Connections between steps"
    }
  },
  "validations": [
    {
      "name": "nodes_not_empty",
      "condition": "nodes.length > 0",
      "message": "Workflow must have at least one node"
    },
    {
      "name": "connections_valid",
      "condition": "validateConnections(nodes, connections)",
      "message": "Connection references must exist in nodes"
    },
    {
      "name": "no_circular_references",
      "condition": "!hasCircularReferences(connections)",
      "message": "Workflow connections must be acyclic (DAG)"
    },
    {
      "name": "version_format",
      "condition": "/^\\d+\\.\\d+\\.\\d+$/.test(version)",
      "message": "Version must follow semantic versioning (X.Y.Z)"
    }
  ],
  "acl": {
    "default": {
      "filter": "{ tenantId: context.tenantId }"
    },
    "permissions": {
      "owner": [
        "create",
        "read",
        "update",
        "delete",
        "publish"
      ],
      "editor": [
        "read",
        "update"
      ],
      "viewer": [
        "read"
      ],
      "admin": [
        "*"
      ]
    }
  },
  "rateLimits": {
    "list": 100,
    "create": 20,
    "update": 50,
    "delete": 10,
    "execute": 200
  },
  "softDelete": true,
  "softDeleteField": "isArchived",
  "events": [
    {
      "name": "workflow.created",
      "description": "Workflow created",
      "payload": [
        "id",
        "name",
        "tenantId",
        "createdBy"
      ]
    },
    {
      "name": "workflow.updated",
      "description": "Workflow updated",
      "payload": [
        "id",
        "version",
        "updatedBy",
        "changes"
      ]
    },
    {
      "name": "workflow.published",
      "description": "Workflow published",
      "payload": [
        "id",
        "version",
        "tenantId"
      ]
    },
    {
      "name": "workflow.executed",
      "description": "Workflow execution started",
      "payload": [
        "id",
        "executionId",
        "tenantId"
      ]
    },
    {
      "name": "workflow.validated",
      "description": "Workflow validation completed",
      "payload": [
        "id",
        "valid",
        "errors",
        "warnings"
      ]
    }
  ],
  "caching": {
    "ttl": 3600,
    "patterns": [
      {
        "key": "workflow:{id}",
        "ttl": 3600
      },
      {
        "key": "workflows:{tenantId}",
        "ttl": 1800
      },
      {
        "key": "workflows:{tenantId}:{status}",
        "ttl": 1800
      }
    ],
    "invalidateOn": [
      "update",
      "publish",
      "delete"
    ]
  }
}
